# Configuration d'exemple pour GotoDrop
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins

# Configuration générale de l'application
APP_NAME=GotoDrop
APP_VERSION=1.0.0

# Images Docker - Remplacez 'your-username' par votre nom d'utilisateur GitHub
BACKEND_IMAGE=ghcr.io/your-username/gotodrop/back
FRONTEND_IMAGE=ghcr.io/your-username/gotodrop/front

# Registry Docker
REGISTRY=ghcr.io
REGISTRY_USERNAME=your-username

# Noms des composants
BACKEND_CONTAINER_NAME=gotodrop-back
FRONTEND_CONTAINER_NAME=gotodrop-front
DATABASE_CONTAINER_NAME=gotodrop-h2
NGINX_CONTAINER_NAME=gotodrop-nginx

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
DATABASE_PORT=1521
DATABASE_WEB_PORT=8082
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090

# URLs - Modifiez selon votre domaine
API_URL=http://localhost:8080/api
FRONTEND_URL=http://localhost:3000

# Base de données
DB_NAME=gotodrop
DB_USERNAME=sa
DB_PASSWORD=

# Spring Boot
SPRING_PROFILES_ACTIVE=docker
SERVER_ADDRESS=0.0.0.0

# Logs
LOG_LEVEL=INFO

# Monitoring
ACTUATOR_ENABLED=true
HEALTH_CHECK_ENABLED=true

# Sécurité
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# GitHub - Remplacez par votre repository
GITHUB_REPOSITORY=your-username/gotodrop
GITHUB_REGISTRY=ghcr.io

# Déploiement
DEPLOY_ENVIRONMENT=development
DEPLOY_PATH=/opt/gotodrop
BACKUP_PATH=/opt/gotodrop/backups
